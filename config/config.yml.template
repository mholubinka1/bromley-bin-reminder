remind:
  url:
  email_addresses:
    - firstname.lastname@provider.com
    - firstname.lastname@provider.com
  time: '18:00'
  tz: 'Europe/London'                                   # optional, defaults to Europe/London if blank or unrecognised

smtp:
  username: sender.email.address@provider.com         # this field is required
  password: $password                                 # if this is blank, no authentication is used
  server: smtp.gmail.com
  port: 587

# Optional: also send push notifications via ntfy. Remove or leave commented to disable.
# ntfy:
#   server: https://ntfy.sh                             # optional, defaults to https://ntfy.sh
#   topic: use-something-long-and-unguessable           # max 64 characters; anyone who knows a public topic name can read it